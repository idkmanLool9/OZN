<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ─── iOS-stijl knoppen ───────────────────────────────────────── -->

    <style name="iOSButton.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="iOSButton.Secondary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/gray_btn</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#22000000</item>
    </style>

    <style name="iOSButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ─── Typografie (iOS-achtige hiërarchie) ─────────────────────── -->

    <style name="iOSText.LargeTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="iOSText.Title2">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="iOSText.Body">
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="iOSText.Caption">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

</resources>
