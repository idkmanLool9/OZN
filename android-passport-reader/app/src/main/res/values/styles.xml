<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base style holders zodat de dot-notatie (iOSButton.Primary,
         iOSText.Body) werkt zonder expliciete parent. -->
    <style name="iOSButton" parent="android:Widget"/>
    <style name="iOSText" parent="android:Widget"/>

    <!-- ════════════════════════════════════════════════════════════════
         TYPOGRAFIE — volledige iOS type-scale (HIG)
         ════════════════════════════════════════════════════════════════ -->

    <!-- LargeTitle — 34sp / Bold. Voor schermtitels die collapsen. -->
    <style name="iOSText.LargeTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.022</item>
        <item name="android:lineSpacingMultiplier">1.05</item>
    </style>

    <!-- Title1 — 28sp / Bold. Voor secties / hero-titels. -->
    <style name="iOSText.Title1">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">28sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.018</item>
        <item name="android:lineSpacingMultiplier">1.1</item>
    </style>

    <!-- Title2 — 22sp / Bold. Voor kleinere page-titles, modal-headers. -->
    <style name="iOSText.Title2">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.012</item>
    </style>

    <!-- Title3 — 20sp / Semibold. Voor card-titels. -->
    <style name="iOSText.Title3">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">20sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.008</item>
    </style>

    <!-- Headline — 17sp / Semibold. Voor cell-titels in lijst. -->
    <style name="iOSText.Headline">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.004</item>
    </style>

    <!-- Body — 17sp / Regular. Voor body-tekst, default reading. -->
    <style name="iOSText.Body">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:letterSpacing">-0.004</item>
    </style>

    <!-- Callout — 16sp / Regular. Lichte hint of bijschrift naast body. -->
    <style name="iOSText.Callout">
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">16sp</item>
    </style>

    <!-- Subhead — 15sp / Regular. Subtitel onder titel. -->
    <style name="iOSText.Subhead">
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">2dp</item>
    </style>

    <!-- Footnote — 13sp / Regular. Voor footer-info, timestamps. -->
    <style name="iOSText.Footnote">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- Caption1 — 12sp / Regular. -->
    <style name="iOSText.Caption">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- Caption2 — 11sp / Regular. Voor tab-bar labels etc. -->
    <style name="iOSText.Caption2">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">11sp</item>
    </style>

    <!-- SectionHeader — 13sp Uppercase, grouped-list section-titels. -->
    <style name="iOSText.SectionHeader">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <!-- ─── Legacy aliassen voor backward-compat ─── -->
    <style name="iOSText.LargeBold" parent="iOSText.Title1"/>
    <style name="iOSText.Subtitle" parent="iOSText.Subhead"/>

    <!-- ════════════════════════════════════════════════════════════════
         BUTTONS — iOS variants: filled / tinted / plain / destructive
         × maten: regular (44dp) / large (52dp) / huge (56dp)
         ════════════════════════════════════════════════════════════════ -->

    <!-- Filled (primary CTA, gevuld met brand-blue) -->
    <style name="iOSButton.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.004</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Filled Large (56dp, voor cruciale acties — hoofd-actie van een
         scherm. Apple's "Continue" button in onboarding-flow stijl.) -->
    <style name="iOSButton.PrimaryLarge" parent="Widget.Material3.Button">
        <item name="android:layout_height">56dp</item>
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.004</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">16dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <!-- Tinted (gevulde knop met soft brand-tint achtergrond, brand-text.
         Voor secundaire-maar-prominente acties.) -->
    <style name="iOSButton.Tinted" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/brand_blue_soft</item>
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.004</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/brand_blue</item>
    </style>

    <!-- Secondary (grijs gevuld, dark text. Voor "Annuleer", "Niet nu".) -->
    <style name="iOSButton.Secondary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/gray_btn</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.004</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#22000000</item>
    </style>

    <!-- Plain text-only (geen achtergrond, alleen brand-text) -->
    <style name="iOSButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.004</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Destructive (red voor delete/logout etc.) -->
    <style name="iOSButton.Destructive" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">#1AFF3B30</item>
        <item name="android:textColor">@color/red</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">-0.004</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">@color/red</item>
    </style>

    <!-- ════════════════════════════════════════════════════════════════
         CARDS & LIJSTEN — iOS grouped-list patterns
         ════════════════════════════════════════════════════════════════ -->

    <!-- iOSCard — flat card, hairline-border, soft radius. -->
    <style name="iOSCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/hair</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/brand_blue_soft</item>
    </style>

    <!-- iOSCard.Elevated — met subtle shadow. -->
    <style name="iOSCard.Elevated">
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">2dp</item>
    </style>

    <!-- iOSGroupedSection — container voor een grouped-list section.
         Apple gebruikt rounded white card met items binnen + hairlines. -->
    <style name="iOSGroupedSection" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <!-- iOSListCell — een rij in een grouped section. Min-height 44dp
         (Apple HIG tap target). -->
    <style name="iOSListCell">
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- iOSDivider — 0.5dp hairline tussen list-cells (inset start 16dp). -->
    <style name="iOSDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0.5dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:background">@color/hair</item>
    </style>

</resources>
