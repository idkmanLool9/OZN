<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base styles: de dot-notatie hieronder (iOSButton.Primary, iOSText.Body
         etc.) zoekt impliciet een parent met dezelfde voor-dot-naam. AAPT
         eist dat die bestaat, dus hier de lege "houders". -->
    <style name="iOSButton" parent="android:Widget"/>
    <style name="iOSText" parent="android:Widget"/>

    <!-- ─── iOS-stijl knoppen ───────────────────────────────────────── -->

    <style name="iOSButton.Primary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/brand_blue</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#33FFFFFF</item>
    </style>

    <style name="iOSButton.Secondary" parent="Widget.Material3.Button">
        <item name="android:layout_height">52dp</item>
        <item name="backgroundTint">@color/gray_btn</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
        <item name="elevation">0dp</item>
        <item name="rippleColor">#22000000</item>
    </style>

    <style name="iOSButton.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/brand_blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ─── Typografie (iOS-achtige hiërarchie) ─────────────────────── -->

    <style name="iOSText.LargeTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">34sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="iOSText.Title2">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="iOSText.Body">
        <item name="android:textColor">@color/ink_2</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
    </style>

    <style name="iOSText.Caption">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <!-- ─── iOS-stijl card (vlak, hairline-border, zachte radius) ───── -->

    <style name="iOSCard" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">@color/surface</item>
        <item name="cardCornerRadius">14dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/hair</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/brand_blue_soft</item>
    </style>

    <style name="iOSCard.Elevated">
        <item name="strokeWidth">0dp</item>
        <item name="cardElevation">2dp</item>
    </style>

</resources>
