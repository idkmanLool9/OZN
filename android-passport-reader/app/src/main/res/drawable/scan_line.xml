<?xml version="1.0" encoding="utf-8"?>
<!-- Geanimeerde scan-lijn: gradient van transparant → geel → transparant.
     Geel = iOS systemYellow #FFCC00, voor zachte high-key tint. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#00FFCC00"
        android:centerColor="#CCFFCC00"
        android:endColor="#00FFCC00"
        android:type="linear"/>
    <corners android:radius="1dp"/>
</shape>
