<?xml version="1.0" encoding="utf-8"?>
<!--
  Line-art: floating witte ID-kaart (met zwarte lijntjes + asterisk) +
  hand vasthoudende telefoon. Exact zoals het user-referentie design
  (Verify Identity / Use your camera to scan your ID card).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="260dp"
    android:height="260dp"
    android:viewportWidth="260"
    android:viewportHeight="260">

    <!-- Card: gevuld wit met rounded corners, top-left geplaatst -->
    <path
        android:pathData="M50,50 Q40,50 40,60 L40,98 Q40,108 50,108 L132,108 Q142,108 142,98 L142,60 Q142,50 132,50 Z"
        android:fillColor="#F2F2F2"/>

    <!-- 3 horizontale lijnen aan linkerzijde van de card -->
    <path
        android:pathData="M55,67 L92,67"
        android:strokeColor="#2C2C2E"
        android:strokeWidth="4"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M55,79 L100,79"
        android:strokeColor="#2C2C2E"
        android:strokeWidth="4"
        android:strokeLineCap="round"/>
    <path
        android:pathData="M55,91 L82,91"
        android:strokeColor="#2C2C2E"
        android:strokeWidth="4"
        android:strokeLineCap="round"/>

    <!-- Asterisk (8-puntig sterretje) aan rechterzijde van card -->
    <path
        android:pathData="M119,67 L119,93 M106,80 L132,80 M110,71 L128,89 M128,71 L110,89"
        android:strokeColor="#2C2C2E"
        android:strokeWidth="3"
        android:strokeLineCap="round"/>

    <!-- Telefoon outline — rechts onder de card -->
    <path
        android:pathData="M138,108 Q128,108 128,118 L128,212 Q128,222 138,222 L195,222 Q205,222 205,212 L205,118 Q205,108 195,108 Z"
        android:strokeColor="#F2F2F2"
        android:strokeWidth="2.4"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <!-- Speaker-strip bovenaan telefoon -->
    <path
        android:pathData="M156,116 L177,116"
        android:strokeColor="#F2F2F2"
        android:strokeWidth="2"
        android:strokeLineCap="round"/>

    <!-- Hand: 3 vingers buigend om rechter-rand van telefoon -->
    <path
        android:pathData="M205,150 C215,150 218,155 218,162 C218,170 215,174 205,174"
        android:strokeColor="#F2F2F2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>
    <path
        android:pathData="M205,174 C215,174 218,179 218,186 C218,194 215,198 205,198"
        android:strokeColor="#F2F2F2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>
    <path
        android:pathData="M205,198 C214,198 217,203 217,210 C217,217 213,221 205,221"
        android:strokeColor="#F2F2F2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <!-- Duim aan linkerzijde van telefoon -->
    <path
        android:pathData="M138,162 C128,162 120,168 120,180 L120,210 C120,230 145,238 165,238"
        android:strokeColor="#F2F2F2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>

    <!-- Pols / arm onderzijde -->
    <path
        android:pathData="M165,238 L210,238 C218,238 222,234 222,228 L222,222"
        android:strokeColor="#F2F2F2"
        android:strokeWidth="2.4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"/>
</vector>
