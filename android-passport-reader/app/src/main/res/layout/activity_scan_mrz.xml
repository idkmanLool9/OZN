<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <androidx.camera.view.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <!-- Donkere overlay buiten de scan-area om focus te leggen op het frame -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"/>

    <!-- Witte pill-hint bovenaan (iOS-stijl) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="56dp"
        android:background="@drawable/bg_hint_pill_light"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:text="@string/scan_title"
        android:textColor="@color/ink"
        android:textSize="14sp"
        android:textStyle="bold"/>

    <!-- Scan-frame: 4 iOS-gele hoek-brackets + animerende scan-lijn -->
    <FrameLayout
        android:id="@+id/scanFrame"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="center"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp">

        <!-- Heldere "kijkvenster"-laag die de donkere overlay doorprikt -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#00000000"/>

        <!-- Geanimeerde scan-lijn in het frame -->
        <View
            android:id="@+id/scanLine"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_gravity="top"
            android:background="@drawable/scan_line"/>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|start"
            android:contentDescription="@null"
            android:src="@drawable/scan_corner"/>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="top|end"
            android:contentDescription="@null"
            android:rotation="90"
            android:src="@drawable/scan_corner"/>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|end"
            android:contentDescription="@null"
            android:rotation="180"
            android:src="@drawable/scan_corner"/>

        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="bottom|start"
            android:contentDescription="@null"
            android:rotation="270"
            android:src="@drawable/scan_corner"/>
    </FrameLayout>

    <!-- iOS-stijl bottom-sheet met instructie + progress -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bottomSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="32dp"
        app:cardBackgroundColor="@color/surface"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/scanStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/scan_hint"
                android:textColor="@color/ink_2"
                android:textSize="14sp"/>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/scanProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:indeterminate="true"
                app:indicatorColor="@color/brand_blue"
                app:trackColor="@color/hair"
                app:trackCornerRadius="2dp"
                app:trackThickness="3dp"/>

            <TextView
                android:id="@+id/debugLine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:gravity="center"
                android:maxLines="2"
                android:textColor="@color/muted_2"
                android:textSize="11sp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Succes-overlay: groene flash + grote checkmark. Hidden by default. -->
    <View
        android:id="@+id/successFlash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_success_flash"
        android:visibility="gone"/>

    <ImageView
        android:id="@+id/successCheck"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:src="@drawable/ic_check_big"
        android:visibility="gone"/>
</FrameLayout>
