<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="@color/surface"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="32dp"
                android:paddingBottom="20dp">

                <!-- ─── Reading-state ─── -->
                <LinearLayout
                    android:id="@+id/readingState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/nfc_title"
                        android:textColor="@color/muted"
                        android:textSize="17sp"/>

                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="160dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="28dp"
                        android:clipChildren="false">

                        <View
                            android:id="@+id/pulseRing"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="center"
                            android:background="@drawable/bg_pulse_ring"/>

                        <ImageView
                            android:layout_width="120dp"
                            android:layout_height="120dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_nfc_phone"/>
                    </FrameLayout>

                    <TextView
                        android:id="@+id/subtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="32dp"
                        android:gravity="center"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/nfc_subtitle"
                        android:textColor="@color/ink_2"
                        android:textSize="15sp"/>

                    <TextView
                        android:id="@+id/docInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:fontFamily="monospace"
                        android:gravity="center"
                        android:textColor="@color/muted"
                        android:textSize="12sp"/>

                    <!-- Stappen-checklist (verschijnt tijdens lezen) -->
                    <LinearLayout
                        android:id="@+id/stepsCard"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <include
                            android:id="@+id/stepConnect"
                            layout="@layout/item_step"/>

                        <include
                            android:id="@+id/stepCrypto"
                            layout="@layout/item_step"/>

                        <include
                            android:id="@+id/stepDg1"
                            layout="@layout/item_step"/>

                        <include
                            android:id="@+id/stepDg2"
                            layout="@layout/item_step"/>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/errorMsg"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_error_rounded"
                        android:padding="12dp"
                        android:textColor="@color/red"
                        android:textSize="13sp"
                        android:visibility="gone"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetry"
                        style="@style/iOSButton.Secondary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="20dp"
                        android:text="@string/nfc_retry"
                        android:visibility="gone"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        style="@style/iOSButton.Secondary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="32dp"
                        android:text="@string/nfc_cancel"/>
                </LinearLayout>

                <!-- ─── Result-state ─── -->
                <LinearLayout
                    android:id="@+id/resultState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/result_title"
                        android:textColor="@color/ink"
                        android:textSize="22sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/result_subtitle"
                        android:textColor="@color/muted"
                        android:textSize="14sp"/>

                    <!-- Pasfoto -->
                    <FrameLayout
                        android:layout_width="160dp"
                        android:layout_height="200dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_card_photo"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/photo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/result_photo_alt"
                            android:scaleType="centerCrop"/>
                    </FrameLayout>

                    <!-- Persoonsgegevens-card (afgerond, geen rand) -->
                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="@color/bg"
                        app:cardCornerRadius="14dp"
                        app:cardElevation="0dp">

                        <LinearLayout
                            android:id="@+id/details"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:paddingTop="6dp"
                            android:paddingBottom="6dp"/>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCouple"
                        style="@style/iOSButton.Primary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="24dp"
                        android:text="@string/nfc_couple_button"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDone"
                        style="@style/iOSButton.Secondary"
                        android:layout_width="match_parent"
                        android:layout_marginTop="10dp"
                        android:text="@string/result_done"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </ScrollView>
</FrameLayout>
