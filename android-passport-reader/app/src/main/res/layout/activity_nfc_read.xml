<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="56dp"
        android:paddingBottom="28dp">

        <!-- ─── Reading-state ─── -->
        <LinearLayout
            android:id="@+id/readingState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Concentrische pulse-ringen rond NFC-icoon -->
            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false">

                <View
                    android:id="@+id/pulseRing1"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pulse_ring"/>

                <View
                    android:id="@+id/pulseRing2"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pulse_ring"/>

                <View
                    android:id="@+id/pulseRing3"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pulse_ring"/>

                <!-- Wit cirkel-platform voor NFC-icoon -->
                <View
                    android:layout_width="130dp"
                    android:layout_height="130dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_hero_circle"/>

                <ImageView
                    android:layout_width="110dp"
                    android:layout_height="110dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_nfc_phone"/>
            </FrameLayout>

            <!-- Grote vette titel -->
            <TextView
                android:id="@+id/title"
                style="@style/iOSText.LargeBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/nfc_title"/>

            <TextView
                android:id="@+id/subtitle"
                style="@style/iOSText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/nfc_subtitle"/>

            <TextView
                android:id="@+id/docInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textSize="12sp"/>

            <!-- Stappen-checklist (verschijnt tijdens lezen) — in card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/stepsCardWrap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/stepsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <include
                        android:id="@+id/stepConnect"
                        layout="@layout/item_step"/>

                    <include
                        android:id="@+id/stepCrypto"
                        layout="@layout/item_step"/>

                    <include
                        android:id="@+id/stepDg1"
                        layout="@layout/item_step"/>

                    <include
                        android:id="@+id/stepDg2"
                        layout="@layout/item_step"/>

                    <include
                        android:id="@+id/stepExtra"
                        layout="@layout/item_step"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:id="@+id/errorMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/bg_error_rounded"
                android:padding="14dp"
                android:textColor="@color/red"
                android:textSize="14sp"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRetry"
                style="@style/iOSButton.PrimaryLarge"
                android:layout_width="match_parent"
                android:layout_marginTop="20dp"
                android:text="@string/nfc_retry"
                android:visibility="gone"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/iOSButton.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="36dp"
                android:text="@string/nfc_cancel"/>
        </LinearLayout>

        <!-- ─── Result-state ─── -->
        <LinearLayout
            android:id="@+id/resultState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                style="@style/iOSText.LargeBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/result_title"/>

            <TextView
                style="@style/iOSText.Subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/result_subtitle"/>

            <!-- ─── Paspoort-kaart visualisatie (zoals echte NL paspoort) ─── -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp">

                <include
                    android:id="@+id/passportCard"
                    layout="@layout/view_passport_card_nl"/>
            </FrameLayout>

            <!-- Toggle: zwart-wit (origineel paspoort-look) ↔ kleur -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFaceColor"
                style="@style/iOSButton.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="4dp"
                android:text="@string/face_show_color"
                app:iconGravity="textStart"
                app:iconPadding="6dp"
                app:iconSize="18dp"
                app:iconTint="@color/brand_blue"/>

            <!-- Originele pasfoto kleiner, links na de card -->
            <ImageView
                android:id="@+id/photo"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone"
                android:contentDescription="@string/result_photo_alt"
                android:scaleType="centerCrop"/>

            <!-- Foto-acties: deel + opslaan, iOS plain-button row -->
            <LinearLayout
                android:id="@+id/photoActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSharePhoto"
                    style="@style/iOSButton.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_share_photo"
                    app:icon="@drawable/ic_share"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/brand_blue"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@color/hair"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSavePhoto"
                    style="@style/iOSButton.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/result_save_photo"
                    app:icon="@drawable/ic_save"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    app:iconSize="18dp"
                    app:iconTint="@color/brand_blue"/>
            </LinearLayout>

            <!-- Persoonsgegevens-card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp">

                <LinearLayout
                    android:id="@+id/details"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"/>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCouple"
                style="@style/iOSButton.PrimaryLarge"
                android:layout_width="match_parent"
                android:layout_marginTop="28dp"
                android:text="@string/nfc_couple_button"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDone"
                style="@style/iOSButton.Secondary"
                android:layout_width="match_parent"
                android:layout_marginTop="10dp"
                android:text="@string/result_done"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
