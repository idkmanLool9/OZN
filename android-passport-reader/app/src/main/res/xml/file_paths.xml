<?xml version="1.0" encoding="utf-8"?>
<!-- Paden die de FileProvider met andere apps mag delen.
     Alleen de "shared" subdir in de internal cache — gebruikt voor de
     pasfoto-share-flow (tijdelijk JPEG dat een andere app ophaalt). -->
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <cache-path
        name="shared"
        path="shared/"/>
</paths>
