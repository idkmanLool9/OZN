# Cloudflare Pages — header-overrides
# https://developers.cloudflare.com/pages/configuration/headers/

# Service-worker en manifest: nooit cachen, anders krijgen gebruikers
# nieuwe versies pas na een handmatige refresh.
/service-worker.js
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

# index.html: nooit uit cache zonder revalidatie — een nieuwe deploy is
# meteen zichtbaar (browser doet altijd een ETag-check bij de server).
/index.html
  Cache-Control: no-cache, must-revalidate

# JS/CSS: 'no-cache' = de browser mag cachen maar MOET elke request
# revalideren bij de server (ETag/If-Modified-Since). Zo krijg je een
# nieuwe build meteen binnen i.p.v. tot 5 min later. Voorkomt ook dat een
# nieuwe service-worker tijdens install per ongeluk oude files cacht.
/js/*
  Cache-Control: no-cache, must-revalidate

/style.css
  Cache-Control: no-cache, must-revalidate

/print.css
  Cache-Control: no-cache, must-revalidate

/icon.svg
  Cache-Control: public, max-age=86400

# Globale veiligheidsheaders
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(), geolocation=()
