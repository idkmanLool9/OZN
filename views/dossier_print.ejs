<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <title>Dossier <%= dossier.dossier_nummer %> · Print</title>
  <link rel="stylesheet" href="/css/print.css" />
</head>
<body>
<% function fmt(v) { return v && String(v).trim() ? v : '—'; } %>

<div class="print-page">
  <header class="print-header">
    <div>
      <h1>Uitvaartdossier</h1>
      <p>Syrisch-Orthodoxe Kerk van Antiochië</p>
    </div>
    <div class="meta">
      <p><strong><%= dossier.dossier_nummer %></strong></p>
      <p>Status: <%= dossier.status.replace('_', ' ') %></p>
      <p>Afgedrukt: <%= new Date().toLocaleString('nl-NL') %></p>
    </div>
  </header>

  <h2>Overledene</h2>
  <table class="kv">
    <tr><th>Naam</th><td><%= fmt([dossier.voornaam, dossier.achternaam].filter(Boolean).join(' ')) %></td>
        <th>Doopnaam</th><td><%= fmt(dossier.doopnaam) %></td></tr>
    <tr><th>Geboren</th><td><%= fmt(dossier.geboortedatum) %><%= dossier.geboorteplaats ? ' te '+dossier.geboorteplaats : '' %></td>
        <th>Geslacht</th><td><%= fmt(dossier.geslacht) %></td></tr>
    <tr><th>Overleden</th><td><%= fmt(dossier.overlijdensdatum) %><%= dossier.overlijdenstijd ? ' '+dossier.overlijdenstijd : '' %><%= dossier.overlijdensplaats ? ' te '+dossier.overlijdensplaats : '' %></td>
        <th>BSN</th><td><%= fmt(dossier.bsn) %></td></tr>
    <tr><th>Adres</th><td colspan="3"><%= fmt([dossier.adres_overledene, dossier.postcode_overledene, dossier.woonplaats_overledene].filter(Boolean).join(', ')) %></td></tr>
    <tr><th>Burgerlijke staat</th><td><%= fmt(dossier.burgerlijke_staat) %></td>
        <th>Nationaliteit</th><td><%= fmt(dossier.nationaliteit) %></td></tr>
  </table>

  <h2>Contactpersoon</h2>
  <table class="kv">
    <tr><th>Naam</th><td><%= fmt(dossier.contact_naam) %></td>
        <th>Relatie</th><td><%= fmt(dossier.contact_relatie) %></td></tr>
    <tr><th>Telefoon</th><td><%= fmt(dossier.contact_telefoon) %></td>
        <th>E-mail</th><td><%= fmt(dossier.contact_email) %></td></tr>
    <tr><th>Adres</th><td colspan="3"><%= fmt([dossier.contact_adres, dossier.contact_postcode, dossier.contact_woonplaats].filter(Boolean).join(', ')) %></td></tr>
  </table>

  <h2>Kerkelijk & uitvaart</h2>
  <table class="kv">
    <tr><th>Parochie</th><td><%= fmt(dossier.parochie) %></td>
        <th>Priester</th><td><%= fmt(dossier.priester) %></td></tr>
    <tr><th>Huisbezoek</th><td><%= fmt(dossier.huisbezoek_datum) %> <%= dossier.huisbezoek_tijd || '' %></td>
        <th>Avondwake</th><td><%= fmt(dossier.avondwake_datum) %> <%= dossier.avondwake_tijd || '' %><br><%= dossier.avondwake_locatie || '' %></td></tr>
    <tr><th>Type uitvaart</th><td><%= fmt(dossier.uitvaart_type) %></td>
        <th>Datum & tijd</th><td><%= fmt(dossier.uitvaart_datum) %> <%= dossier.uitvaart_tijd || '' %></td></tr>
    <tr><th>Kerk</th><td colspan="3"><%= fmt(dossier.kerk_locatie) %></td></tr>
    <tr><th>Begraafplaats</th><td><%= fmt(dossier.begraafplaats) %></td>
        <th>Graf</th><td><%= fmt(dossier.graf_nummer) %> <%= dossier.graf_type ? '('+dossier.graf_type+')' : '' %></td></tr>
  </table>

  <h2>Logistiek</h2>
  <table class="kv">
    <tr><th>Kist</th><td><%= fmt(dossier.kist_type) %></td>
        <th>Rouwauto</th><td><%= fmt(dossier.rouwauto) %></td></tr>
    <tr><th>Volgauto's</th><td><%= fmt(dossier.aantal_volgauto) %></td>
        <th>Dragers</th><td><%= fmt(dossier.dragers) %></td></tr>
    <tr><th>Bloemstukken</th><td><%= fmt(dossier.bloemstukken) %></td>
        <th>Rouwkaarten</th><td><%= fmt(dossier.rouwkaarten_aantal) %></td></tr>
    <tr><th>Condoleance</th><td><%= fmt(dossier.condoleance_locatie) %></td>
        <th>Catering</th><td><%= fmt(dossier.catering) %></td></tr>
    <tr><th>Muziek/koor</th><td colspan="3"><%= fmt(dossier.muziek_zang) %></td></tr>
  </table>

  <h2>Verzekering</h2>
  <table class="kv">
    <tr><th>Maatschappij</th><td><%= fmt(dossier.verzekering_maatschappij) %></td>
        <th>Polisnummer</th><td><%= fmt(dossier.polisnummer) %></td></tr>
    <tr><th>Opdrachtgever</th><td><%= fmt(dossier.opdrachtgever_naam) %></td>
        <th>Telefoon</th><td><%= fmt(dossier.opdrachtgever_telefoon) %></td></tr>
  </table>

  <% if (dossier.bijzonderheden) { %>
    <h2>Bijzonderheden</h2>
    <p class="prewrap"><%= dossier.bijzonderheden %></p>
  <% } %>

  <% if (taken.length) { %>
    <h2>Taken</h2>
    <ul class="checklist">
      <% taken.forEach(t => { %>
        <li><span class="box"><%= t.voltooid ? '✓' : '☐' %></span> <%= t.omschrijving %><% if (t.deadline) { %> <em>(<%= t.deadline %>)</em><% } %></li>
      <% }) %>
    </ul>
  <% } %>

  <% if (kosten.length) { %>
    <h2>Kosten</h2>
    <table class="kosten">
      <thead><tr><th>Omschrijving</th><th>Categorie</th><th>Bedrag</th><th>Betaald</th></tr></thead>
      <tbody>
        <% kosten.forEach(k => { %>
          <tr>
            <td><%= k.omschrijving %></td>
            <td><%= k.categorie || '' %></td>
            <td>€ <%= (k.bedrag||0).toFixed(2).replace('.', ',') %></td>
            <td><%= k.betaald ? 'ja' : 'nee' %></td>
          </tr>
        <% }) %>
        <tr class="total"><td colspan="2"><strong>Totaal</strong></td><td><strong>€ <%= totaalKosten.toFixed(2).replace('.', ',') %></strong></td><td></td></tr>
      </tbody>
    </table>
  <% } %>

  <p class="footer-note muted small">Intern document · Syrisch-Orthodoxe Kerk van Antiochië · Uitvaartbeheer</p>
</div>

<script>window.addEventListener('load', () => setTimeout(() => window.print(), 300));</script>
</body>
</html>
