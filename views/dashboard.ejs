<% const title = 'Dashboard'; %>
<%- include('partials/header', { title: title }) %>

<div class="page">
  <div class="page-head">
    <h1>Dashboard</h1>
    <a href="/dossiers/nieuw" class="btn btn-primary">+ Nieuw dossier</a>
  </div>

  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Totaal dossiers</div>
      <div class="stat-value"><%= stats.totaal %></div>
    </div>
    <div class="stat-card stat-blue">
      <div class="stat-label">Nieuw</div>
      <div class="stat-value"><%= stats.nieuw %></div>
    </div>
    <div class="stat-card stat-amber">
      <div class="stat-label">In behandeling</div>
      <div class="stat-value"><%= stats.in_behandeling %></div>
    </div>
    <div class="stat-card stat-green">
      <div class="stat-label">Voltooid</div>
      <div class="stat-value"><%= stats.voltooid %></div>
    </div>
  </div>

  <div class="grid-2">
    <section class="card">
      <h2>Aankomende uitvaarten</h2>
      <% if (aankomend.length === 0) { %>
        <p class="muted">Geen aankomende uitvaarten ingepland.</p>
      <% } else { %>
        <ul class="list">
          <% aankomend.forEach(d => { %>
            <li>
              <a href="/dossiers/<%= d.id %>" class="list-link">
                <strong><%= d.voornaam %> <%= d.achternaam %></strong>
                <span class="muted small"><%= d.dossier_nummer %></span>
              </a>
              <span class="badge"><%= d.uitvaart_datum %><% if (d.uitvaart_tijd) { %> · <%= d.uitvaart_tijd %><% } %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>

    <section class="card">
      <h2>Open taken met deadline</h2>
      <% if (openTaken.length === 0) { %>
        <p class="muted">Geen openstaande taken met deadline.</p>
      <% } else { %>
        <ul class="list">
          <% openTaken.forEach(t => { %>
            <li>
              <a href="/dossiers/<%= t.dossier_id %>#taken" class="list-link">
                <%= t.omschrijving %>
                <span class="muted small">— <%= t.voornaam %> <%= t.achternaam %></span>
              </a>
              <span class="badge badge-amber"><%= t.deadline %></span>
            </li>
          <% }) %>
        </ul>
      <% } %>
    </section>
  </div>

  <section class="card">
    <h2>Recent bewerkt</h2>
    <% if (recent.length === 0) { %>
      <p class="muted">Nog geen dossiers. <a href="/dossiers/nieuw">Maak het eerste dossier aan</a>.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Dossier</th>
            <th>Overledene</th>
            <th>Overlijdensdatum</th>
            <th>Uitvaartdatum</th>
            <th>Status</th>
            <th>Bijgewerkt</th>
          </tr>
        </thead>
        <tbody>
          <% recent.forEach(d => { %>
            <tr>
              <td><a href="/dossiers/<%= d.id %>"><%= d.dossier_nummer %></a></td>
              <td><%= [d.voornaam, d.achternaam].filter(Boolean).join(' ') || '—' %></td>
              <td><%= d.overlijdensdatum || '—' %></td>
              <td><%= d.uitvaart_datum || '—' %></td>
              <td><span class="status status-<%= d.status %>"><%= d.status.replace('_', ' ') %></span></td>
              <td class="muted small"><%= d.updated_at %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
