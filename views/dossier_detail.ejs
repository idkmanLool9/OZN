<% const title = `${dossier.voornaam || ''} ${dossier.achternaam || ''}`.trim() || dossier.dossier_nummer; %>
<%- include('partials/header', { title: title }) %>

<% function fmt(v) { return v && String(v).trim() ? v : '—'; } %>

<div class="page">
  <div class="page-head">
    <div>
      <a href="/dossiers" class="back-link">← Dossiers</a>
      <h1><%= [dossier.voornaam, dossier.achternaam].filter(Boolean).join(' ') || 'Dossier' %></h1>
      <p class="muted">
        <strong><%= dossier.dossier_nummer %></strong> ·
        <span class="status status-<%= dossier.status %>"><%= dossier.status.replace('_', ' ') %></span>
      </p>
    </div>
    <div class="page-actions">
      <a href="/dossiers/<%= dossier.id %>/print" class="btn btn-ghost" target="_blank">Print</a>
      <a href="/dossiers/<%= dossier.id %>/bewerken" class="btn btn-primary">Bewerken</a>
      <form method="post" action="/dossiers/<%= dossier.id %>/verwijderen" onsubmit="return confirm('Weet u zeker dat u dit dossier wilt verwijderen? Dit kan niet ongedaan worden gemaakt.');">
        <button type="submit" class="btn btn-danger">Verwijderen</button>
      </form>
    </div>
  </div>

  <nav class="tabs">
    <a href="#overzicht">Overzicht</a>
    <a href="#taken">Taken (<%= taken.filter(t=>!t.voltooid).length %>/<%= taken.length %>)</a>
    <a href="#kosten">Kosten</a>
    <a href="#documenten">Documenten (<%= documenten.length %>)</a>
    <a href="#notities">Notities (<%= notities.length %>)</a>
  </nav>

  <section id="overzicht" class="card">
    <h2>Overzicht</h2>

    <h3>Overledene</h3>
    <dl class="dl">
      <div><dt>Naam</dt><dd><%= fmt([dossier.voornaam, dossier.achternaam].filter(Boolean).join(' ')) %></dd></div>
      <div><dt>Doopnaam</dt><dd><%= fmt(dossier.doopnaam) %></dd></div>
      <div><dt>Geslacht</dt><dd><%= fmt(dossier.geslacht) %></dd></div>
      <div><dt>Geboortedatum</dt><dd><%= fmt(dossier.geboortedatum) %><%= dossier.geboorteplaats ? ' te ' + dossier.geboorteplaats : '' %></dd></div>
      <div><dt>Overleden op</dt><dd><%= fmt(dossier.overlijdensdatum) %><%= dossier.overlijdenstijd ? ' om ' + dossier.overlijdenstijd : '' %><%= dossier.overlijdensplaats ? ' te ' + dossier.overlijdensplaats : '' %></dd></div>
      <div><dt>Adres</dt><dd><%= fmt([dossier.adres_overledene, dossier.postcode_overledene, dossier.woonplaats_overledene].filter(Boolean).join(', ')) %></dd></div>
      <div><dt>BSN</dt><dd><%= fmt(dossier.bsn) %></dd></div>
      <div><dt>Burgerlijke staat</dt><dd><%= fmt(dossier.burgerlijke_staat) %></dd></div>
      <div><dt>Nationaliteit</dt><dd><%= fmt(dossier.nationaliteit) %></dd></div>
      <div><dt>Beroep</dt><dd><%= fmt(dossier.beroep) %></dd></div>
      <div><dt>Lid SOK</dt><dd><%= fmt(dossier.syrisch_orthodox_lid) %></dd></div>
    </dl>

    <h3>Contactpersoon</h3>
    <dl class="dl">
      <div><dt>Naam</dt><dd><%= fmt(dossier.contact_naam) %><%= dossier.contact_relatie ? ' (' + dossier.contact_relatie + ')' : '' %></dd></div>
      <div><dt>Telefoon</dt><dd><%= fmt(dossier.contact_telefoon) %></dd></div>
      <div><dt>E-mail</dt><dd><%= fmt(dossier.contact_email) %></dd></div>
      <div><dt>Adres</dt><dd><%= fmt([dossier.contact_adres, dossier.contact_postcode, dossier.contact_woonplaats].filter(Boolean).join(', ')) %></dd></div>
    </dl>

    <h3>Kerkelijk</h3>
    <dl class="dl">
      <div><dt>Parochie</dt><dd><%= fmt(dossier.parochie) %></dd></div>
      <div><dt>Priester</dt><dd><%= fmt(dossier.priester) %></dd></div>
      <div><dt>Huisbezoek</dt><dd><%= fmt(dossier.huisbezoek_datum) %><%= dossier.huisbezoek_tijd ? ' ' + dossier.huisbezoek_tijd : '' %></dd></div>
      <div><dt>Avondwake</dt><dd><%= fmt(dossier.avondwake_datum) %><%= dossier.avondwake_tijd ? ' ' + dossier.avondwake_tijd : '' %><%= dossier.avondwake_locatie ? ' — ' + dossier.avondwake_locatie : '' %></dd></div>
    </dl>

    <h3>Uitvaartdienst & ter aardebestelling</h3>
    <dl class="dl">
      <div><dt>Type</dt><dd><%= fmt(dossier.uitvaart_type) %></dd></div>
      <div><dt>Datum & tijd</dt><dd><%= fmt(dossier.uitvaart_datum) %><%= dossier.uitvaart_tijd ? ' om ' + dossier.uitvaart_tijd : '' %></dd></div>
      <div><dt>Kerk</dt><dd><%= fmt(dossier.kerk_locatie) %></dd></div>
      <div><dt>Begraafplaats</dt><dd><%= fmt(dossier.begraafplaats) %><%= dossier.graf_nummer ? ' — graf ' + dossier.graf_nummer : '' %><%= dossier.graf_type ? ' (' + dossier.graf_type + ')' : '' %></dd></div>
    </dl>

    <h3>Logistiek</h3>
    <dl class="dl">
      <div><dt>Kist</dt><dd><%= fmt(dossier.kist_type) %></dd></div>
      <div><dt>Rouwauto</dt><dd><%= fmt(dossier.rouwauto) %></dd></div>
      <div><dt>Volgauto's</dt><dd><%= fmt(dossier.aantal_volgauto) %></dd></div>
      <div><dt>Dragers</dt><dd><%= fmt(dossier.dragers) %></dd></div>
      <div><dt>Bloemstukken</dt><dd><%= fmt(dossier.bloemstukken) %></dd></div>
      <div><dt>Rouwkaarten</dt><dd><%= fmt(dossier.rouwkaarten_aantal) %></dd></div>
      <div><dt>Condoleance</dt><dd><%= fmt(dossier.condoleance_locatie) %></dd></div>
      <div><dt>Catering</dt><dd><%= fmt(dossier.catering) %></dd></div>
      <div><dt>Muziek / koor</dt><dd><%= fmt(dossier.muziek_zang) %></dd></div>
    </dl>

    <h3>Verzekering & opdrachtgever</h3>
    <dl class="dl">
      <div><dt>Verzekering</dt><dd><%= fmt(dossier.verzekering_maatschappij) %></dd></div>
      <div><dt>Polisnummer</dt><dd><%= fmt(dossier.polisnummer) %></dd></div>
      <div><dt>Opdrachtgever</dt><dd><%= fmt(dossier.opdrachtgever_naam) %></dd></div>
      <div><dt>Telefoon</dt><dd><%= fmt(dossier.opdrachtgever_telefoon) %></dd></div>
    </dl>

    <% if (dossier.bijzonderheden) { %>
      <h3>Bijzonderheden</h3>
      <p class="prewrap"><%= dossier.bijzonderheden %></p>
    <% } %>
  </section>

  <section id="taken" class="card">
    <h2>Taken / checklist</h2>
    <% if (taken.length === 0) { %>
      <p class="muted">Nog geen taken.</p>
    <% } else { %>
      <ul class="taken-list">
        <% taken.forEach(t => { %>
          <li class="<%= t.voltooid ? 'voltooid' : '' %>">
            <form method="post" action="/dossiers/<%= dossier.id %>/taken/<%= t.id %>/toggle" class="inline">
              <button type="submit" class="check" aria-label="aan/uit"><%= t.voltooid ? '✓' : '○' %></button>
            </form>
            <span class="taak-tekst"><%= t.omschrijving %></span>
            <% if (t.deadline) { %><span class="badge badge-amber"><%= t.deadline %></span><% } %>
            <% if (t.voltooid) { %><span class="muted small">voltooid <%= t.voltooid_op %></span><% } %>
            <form method="post" action="/dossiers/<%= dossier.id %>/taken/<%= t.id %>/verwijderen" class="inline right" onsubmit="return confirm('Taak verwijderen?');">
              <button type="submit" class="btn-icon" title="verwijderen">×</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <form method="post" action="/dossiers/<%= dossier.id %>/taken" class="row-form">
      <input type="text" name="omschrijving" placeholder="Nieuwe taak..." required />
      <input type="date" name="deadline" />
      <button type="submit" class="btn">+ Toevoegen</button>
    </form>
  </section>

  <section id="kosten" class="card">
    <h2>Kosten</h2>
    <% if (kosten.length === 0) { %>
      <p class="muted">Nog geen kostenposten.</p>
    <% } else { %>
      <table class="table">
        <thead>
          <tr>
            <th>Omschrijving</th>
            <th>Categorie</th>
            <th class="num">Bedrag</th>
            <th>Betaald</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% kosten.forEach(k => { %>
            <tr>
              <td><%= k.omschrijving %></td>
              <td><%= k.categorie || '—' %></td>
              <td class="num">€ <%= (k.bedrag || 0).toFixed(2).replace('.', ',') %></td>
              <td>
                <form method="post" action="/dossiers/<%= dossier.id %>/kosten/<%= k.id %>/toggle" class="inline">
                  <button type="submit" class="check small"><%= k.betaald ? '✓' : '○' %></button>
                </form>
              </td>
              <td>
                <form method="post" action="/dossiers/<%= dossier.id %>/kosten/<%= k.id %>/verwijderen" class="inline" onsubmit="return confirm('Kostenpost verwijderen?');">
                  <button type="submit" class="btn-icon">×</button>
                </form>
              </td>
            </tr>
          <% }) %>
          <tr class="total-row">
            <td colspan="2"><strong>Totaal</strong></td>
            <td class="num"><strong>€ <%= totaalKosten.toFixed(2).replace('.', ',') %></strong></td>
            <td colspan="2" class="muted small">waarvan betaald: € <%= betaaldKosten.toFixed(2).replace('.', ',') %></td>
          </tr>
        </tbody>
      </table>
    <% } %>

    <form method="post" action="/dossiers/<%= dossier.id %>/kosten" class="row-form">
      <input type="text" name="omschrijving" placeholder="Omschrijving..." required />
      <select name="categorie">
        <option value="">Categorie</option>
        <option value="kerk">Kerk</option>
        <option value="kist">Kist</option>
        <option value="vervoer">Vervoer</option>
        <option value="bloemen">Bloemen</option>
        <option value="rouwkaarten">Rouwkaarten</option>
        <option value="catering">Catering</option>
        <option value="begraafplaats">Begraafplaats</option>
        <option value="overig">Overig</option>
      </select>
      <input type="text" name="bedrag" placeholder="0,00" inputmode="decimal" />
      <label class="checkbox-inline"><input type="checkbox" name="betaald" /> betaald</label>
      <button type="submit" class="btn">+ Toevoegen</button>
    </form>
  </section>

  <section id="documenten" class="card">
    <h2>Documenten</h2>
    <% if (documenten.length === 0) { %>
      <p class="muted">Nog geen documenten geüpload.</p>
    <% } else { %>
      <ul class="doc-list">
        <% documenten.forEach(d => { %>
          <li>
            <a href="/dossiers/<%= dossier.id %>/documenten/<%= d.id %>/download"><%= d.naam %></a>
            <% if (d.type) { %><span class="badge"><%= d.type %></span><% } %>
            <span class="muted small"><%= (d.grootte/1024).toFixed(0) %> KB · <%= d.geupload_op %></span>
            <form method="post" action="/dossiers/<%= dossier.id %>/documenten/<%= d.id %>/verwijderen" class="inline right" onsubmit="return confirm('Document verwijderen?');">
              <button type="submit" class="btn-icon">×</button>
            </form>
          </li>
        <% }) %>
      </ul>
    <% } %>

    <form method="post" action="/dossiers/<%= dossier.id %>/documenten" enctype="multipart/form-data" class="row-form">
      <input type="text" name="naam" placeholder="Documentnaam (optioneel)" />
      <select name="type">
        <option value="">Type</option>
        <option value="overlijdensakte">Overlijdensakte</option>
        <option value="identiteitsbewijs">Identiteitsbewijs</option>
        <option value="medische verklaring">Medische verklaring</option>
        <option value="verzekeringspolis">Verzekeringspolis</option>
        <option value="grafrechten">Grafrechten</option>
        <option value="verlof tot begraven">Verlof tot begraven</option>
        <option value="overig">Overig</option>
      </select>
      <input type="file" name="bestand" required />
      <button type="submit" class="btn">+ Uploaden</button>
    </form>
  </section>

  <section id="notities" class="card">
    <h2>Notities</h2>
    <form method="post" action="/dossiers/<%= dossier.id %>/notities" class="form">
      <textarea name="tekst" rows="3" placeholder="Nieuwe notitie..." required></textarea>
      <button type="submit" class="btn">+ Notitie toevoegen</button>
    </form>

    <% if (notities.length === 0) { %>
      <p class="muted">Nog geen notities.</p>
    <% } else { %>
      <ul class="notitie-list">
        <% notities.forEach(n => { %>
          <li>
            <div class="notitie-meta">
              <strong><%= n.auteur_naam || 'Onbekend' %></strong>
              <span class="muted small"><%= n.created_at %></span>
              <form method="post" action="/dossiers/<%= dossier.id %>/notities/<%= n.id %>/verwijderen" class="inline right" onsubmit="return confirm('Notitie verwijderen?');">
                <button type="submit" class="btn-icon">×</button>
              </form>
            </div>
            <div class="prewrap"><%= n.tekst %></div>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>
</div>

<%- include('partials/footer') %>
